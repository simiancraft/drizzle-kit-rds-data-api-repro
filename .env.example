# Copy to .env and fill in from your own Aurora Serverless v2 cluster with the
# Data API enabled. Every value is account-specific; none are committed.
#
# The database should be EMPTY and dedicated to this reproduction: drizzle-kit
# push proposes destructive DDL, so never point this at a database you care
# about.

AWS_REGION=us-east-1
DRIZZLE_REPRO_CLUSTER_ARN=arn:aws:rds:us-east-1:000000000000:cluster:your-cluster
DRIZZLE_REPRO_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:your-secret
DRIZZLE_REPRO_DATABASE=drizzle_repro
